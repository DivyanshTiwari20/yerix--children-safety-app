PORT=4000
SUPABASE_URL=https://your-project.supabase.co
# Set one of these Supabase client keys; the server accepts either variable name.
SUPABASE_ANON_KEY=your_supabase_anon_key
# SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SERVICE_KEY=your_service_role_key
AUTH_REDIRECT_URL=yerix://auth/callback
# Configure the Google OAuth web client ID and secret in Supabase Auth, not in the app.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Set either TWILIO_AUTH_TOKEN or both API key values.
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
PUBLIC_BASE_URL=http://localhost:4000
